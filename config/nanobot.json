{
  "model": "claude-sonnet-4-6",
  "max_tokens": 4096,
  "temperature": 1.0,
  "timezone": "Europe/Madrid",
  "language": "ru",
  "voice": {
    "transcription_model": "whisper-1",
    "transcription_language": "ru",
    "tts_model": "tts-1",
    "tts_voice": "nova"
  },
  "history": {
    "max_messages": 40,
    "keep_last": 30
  },
  "yadisk": {
    "readonly_mount": "/mnt/yadisk-readonly",
    "agent_mount": "/mnt/yadisk-agent",
    "index_file": "/mnt/yadisk-agent/index/file_index.json"
  },
  "index": {
    "include_folders": ["Документы", "Clients", "Spain taxes", "morshin.pro", "Яндекс.Фото"],
    "exclude_extensions": [".dt", ".cf", ".cf2", ".cfe", ".zip", ".rar", ".7z", ".tar", ".exe", ".msi", ".dmg", ".db", ".sqlite", ".mdf"],
    "exclude_folders": ["Скриншоты", "Screenshots", "Клиент_", "Client_", "Архив клиентов", ".trash", "Корзина"],
    "max_size_kb": 51200,
    "max_age_years": 3
  }
}
