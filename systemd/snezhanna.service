[Unit]
Description=Snezhanna Personal AI Assistant
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=snezhanna
WorkingDirectory=/opt/snezhanna
EnvironmentFile=/opt/snezhanna/.env
ExecStartPre=/bin/mkdir -p /opt/snezhanna/data
ExecStart=/usr/bin/node /opt/snezhanna/index.js
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=snezhanna

# Resource caps — keep one runaway instance from starving the others on a
# shared multi-bot host. Raise MemoryMax if this instance needs more headroom.
MemoryMax=512M
CPUQuota=100%
TasksMax=256

[Install]
WantedBy=multi-user.target
