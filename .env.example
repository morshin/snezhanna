# Claude API
ANTHROPIC_API_KEY=

# Telegram — Snezhanna bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# Telegram — Zhora watchdog bot
WATCHDOG_BOT_TOKEN=

# OpenAI (Whisper transcription + TTS)
OPENAI_API_KEY=

# Google OAuth2 (Calendar + Gmail + Drive)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub (optional — milestones + issue reporting)
# GITHUB_TOKEN: tenant's own token for reading their milestones/repos
# scopes: public_repo (public repos) or repo (private repos)
GITHUB_TOKEN=

# GitHub issue reporting via main instance proxy (recommended for tenant instances)
# Set REPORT_ISSUE_ENDPOINT to the main instance API URL and share the same secret.
# Tenant instances proxy issue creation through the main instance — no GitHub credentials needed.
# REPORT_ISSUE_ENDPOINT=http://<main-instance-ip>:3001
REPORT_ISSUE_ENDPOINT=
REPORT_ISSUE_SECRET=

# GitHub App credentials (main instance only — not needed if proxy is configured)
# App ID is set in config/nanobot.json (github.app_id) — auto-deployed via update.sh.
# Private key must be added manually once (not committed — repo is public):
#   GITHUB_APP_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----\n
GITHUB_APP_PRIVATE_KEY=

# Fallback PAT (used if neither proxy nor App is configured)
GITHUB_ISSUES_TOKEN=

# Strava (optional — fitness tracking)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=

# Multi-instance overrides (optional — for running multiple instances on the same VPS)
# Each instance should have a unique port in config/nanobot.json (mini_app.port)
# GOOGLE_TOKEN_FILE: path to OAuth token (default: ./token.json)
GOOGLE_TOKEN_FILE=
# GOOGLE_CREDENTIALS_FILE: path to credentials.json (default: ./credentials.json)
GOOGLE_CREDENTIALS_FILE=
# STATE_FILE: path to state file (default: ./.nanobot/state.json)
STATE_FILE=

# Tutor bot — Max (son's study assistant)
# TUTOR_BOT_TOKEN: token from @BotFather
TUTOR_BOT_TOKEN=
# TUTOR_ALLOWED_USER_ID: son's numeric Telegram ID (or @username)
TUTOR_ALLOWED_USER_ID=
# KIDS_DATA_DIR: path to local data folder (optional, default: /opt/snezhanna/data/kids)
KIDS_DATA_DIR=

# Max Parent Interface
# PARENT_CHAT_ID: parent's numeric Telegram ID (same value as TELEGRAM_ALLOWED_USER_ID in Snezhanna)
PARENT_CHAT_ID=
# QUEST_HMAC_SECRET: random 32-char hex string, shared with TimeGuard to verify balance.json
QUEST_HMAC_SECRET=
