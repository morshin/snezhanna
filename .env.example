# Claude API
ANTHROPIC_API_KEY=

# Telegram — Snezhanna bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# Telegram — Zhora watchdog bot
WATCHDOG_BOT_TOKEN=

# OpenAI (Whisper transcription + TTS)
OPENAI_API_KEY=

# Google OAuth2 (Calendar + Gmail)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Yandex Disk WebDAV
YANDEX_WEBDAV_LOGIN=
YANDEX_WEBDAV_PASSWORD=

# GitHub (optional — Issues integration)
GITHUB_TOKEN=           # personal access token; scopes: public_repo (public repos) or repo (private repos)

# Strava (optional — fitness tracking)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=

# Multi-instance overrides (optional — for running multiple instances on the same VPS)
# Each instance should have a unique port in config/nanobot.json (mini_app.port)
GOOGLE_TOKEN_FILE=       # path to OAuth token, default: ./token.json
GOOGLE_CREDENTIALS_FILE= # path to credentials.json, default: ./credentials.json
STATE_FILE=              # path to state file, default: ./.nanobot/state.json

# Tutor bot — Max (son's study assistant)
TUTOR_BOT_TOKEN=         # токен от @BotFather
TUTOR_ALLOWED_USER_ID=   # числовой Telegram ID сына (или @username)
KIDS_DATA_DIR=           # путь к папке с данными, по умолчанию /mnt/yadisk-agent/kids

# Max Parent Interface
PARENT_CHAT_ID=          # числовой Telegram ID родителя (то же значение что TELEGRAM_ALLOWED_USER_ID в Snezhanna)
QUEST_HMAC_SECRET=       # случайная 32-символьная строка, будет использоваться TimeGuard для проверки balance.json
