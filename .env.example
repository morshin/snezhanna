# Claude API
ANTHROPIC_API_KEY=

# Telegram — Snezhanna bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# Telegram — Zhora watchdog bot
WATCHDOG_BOT_TOKEN=

# OpenAI (Whisper transcription + TTS)
OPENAI_API_KEY=

# Google OAuth2 (Calendar + Gmail + Drive)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Encryption key for stored email account credentials (IMAP passwords, per-account
# Gmail OAuth tokens in the email_accounts table). 64 hex chars (32 bytes).
# Generate once with: openssl rand -hex 32
# NEVER rotate an existing key — doing so makes already-encrypted rows unreadable.
CREDENTIALS_KEY=

# GitHub (optional — milestones + issue reporting)
# GITHUB_TOKEN: used by Zhora to post issues received from tenant bots; also used by Snezhanna
# for reading milestones/releases. Scopes: public_repo (public repos) or repo (private repos).
GITHUB_TOKEN=

# GitHub issue reporting via Zhora Telegram relay (recommended for tenant instances)
# 1. Create a private Telegram group, add Zhora bot + each Snezhanna instance bot.
# 2. Disable Zhora's privacy mode in BotFather (Bot Settings → Group Privacy → Turn off).
# 3. Get the group chat ID and set it here (same value for Zhora and all Snezhanna instances).
# Zhora receives /report_issue commands from Snezhanna and creates GitHub issues using GITHUB_TOKEN.
ZHORA_REPORT_CHAT=

# HTTP proxy fallback (legacy — use ZHORA_REPORT_CHAT instead)
# Set REPORT_ISSUE_ENDPOINT to the main instance API URL and share the same secret.
REPORT_ISSUE_ENDPOINT=
REPORT_ISSUE_SECRET=

# GitHub App credentials (main instance only — not needed if relay is configured)
# App ID is set via GITHUB_APP_ID env var.
# Private key must be added manually once (not committed — repo is public):
#   GITHUB_APP_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----\n
GITHUB_APP_PRIVATE_KEY=

# Direct PAT (used if neither relay, proxy, nor App is configured)
GITHUB_ISSUES_TOKEN=

# Strava (optional — fitness tracking)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=

# Multi-instance overrides (optional — for running multiple instances on the same VPS)
# Each instance should have a unique port via MINI_APP_PORT env var
# GOOGLE_TOKEN_FILE: path to OAuth token (default: ./token.json)
GOOGLE_TOKEN_FILE=
# GOOGLE_CREDENTIALS_FILE: path to credentials.json (default: ./credentials.json)
GOOGLE_CREDENTIALS_FILE=
# STATE_FILE: path to state file (default: ./.nanobot/state.json)
STATE_FILE=

# Tutor bot — Max (son's study assistant)
# TUTOR_BOT_TOKEN: token from @BotFather
TUTOR_BOT_TOKEN=
# TUTOR_ALLOWED_USER_ID: son's numeric Telegram ID (or @username)
TUTOR_ALLOWED_USER_ID=
# KIDS_DATA_DIR: path to local data folder (optional, default: /opt/snezhanna/data/kids)
KIDS_DATA_DIR=
# TUTOR_DISABLED=1: set this if the instance doesn't run the tutor bot at all,
# so Zhora doesn't try to monitor/restart a `tutor` systemd unit that's meant
# to stay stopped. Leave unset (or 0) to have Zhora monitor it normally.
TUTOR_DISABLED=

# Max Parent Interface
# PARENT_CHAT_ID: parent's numeric Telegram ID (same value as TELEGRAM_ALLOWED_USER_ID in Snezhanna)
PARENT_CHAT_ID=
# QUEST_HMAC_SECRET: random 32-char hex string, shared with TimeGuard to verify balance.json
QUEST_HMAC_SECRET=

# Bot identity
ASSISTANT_NAME=Снежанна          # bot's display name
USER_NAME=шеф                    # how the bot addresses the owner (fallback before onboarding)

# Claude model
CLAUDE_MODEL=claude-sonnet-4-6
# CLAUDE_MAX_TOKENS=4096         # optional override

# Localization
TIMEZONE=Europe/Madrid

# Google Drive
GDRIVE_ROOT_FOLDER=Снежанна      # root folder name in Drive

# GitHub Milestones (optional)
# GITHUB_SELF_REPO=owner/repo    # bot's own repo for issue creation
# GITHUB_MILESTONE_DAYS=14       # show milestones due within N days
# GITHUB_REPOS=[]                # JSON array: [{"repo":"owner/repo","project":"Name"}]

# Mini App
# MINI_APP_PORT=3001

# Database
# DATABASE_PATH=data/snezhanna.db

# Integrations (set to false to disable)
# INTEGRATIONS_STRAVA=true
# INTEGRATIONS_GITHUB=true
# INTEGRATIONS_CHAT_MONITOR=true
